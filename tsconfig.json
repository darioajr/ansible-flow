{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@visual-ansible/*": ["./packages/*/src/index.ts"],
      "@/*": ["./apps/web/*"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "apps/vscode/**/*.ts",
    "apps/vscode/**/*.tsx",
    "tests/**/*.ts",
    "*.ts"
  ],
  "exclude": ["node_modules", "**/dist", "**/.next"]
}
