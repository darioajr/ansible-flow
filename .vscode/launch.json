{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Visual Ansible Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode/extension"
      ],
      "outFiles": ["${workspaceFolder}/apps/vscode/extension/dist/**/*.cjs"],
      "preLaunchTask": "build extension"
    }
  ]
}
